# Generate a URL-safe random password; never commit the actual .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
# For a local Python installation connected to PostgreSQL 18, set this separately:
# QB_DATABASE_URL=postgresql://question_bank:PASSWORD@127.0.0.1:5432/question_bank
# QB_DATABASE_SCHEMA=question_bank
# OSS 直存媒体（可选；设置后图片/录音不再落本地盘）
# QB_OSS_BUCKET=questio-bank
# QB_OSS_ENDPOINT=https://oss-cn-shanghai-internal.aliyuncs.com
# QB_OSS_PUBLIC_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
# 凭证缺省回落 ALIBABA_CLOUD_ACCESS_KEY_ID/SECRET
